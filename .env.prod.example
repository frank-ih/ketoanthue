# ===========================================
# Ketoanthue Production Environment
# Copy to .env.prod and fill in real values
# ===========================================

# PostgreSQL
POSTGRES_DB=ketoanthue
POSTGRES_USER=ketoanthue
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
DATABASE_URL=postgresql://ketoanthue:${POSTGRES_PASSWORD}@postgres:5432/ketoanthue

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Backend API
PORT=3001
ALLOWED_ORIGINS=https://ketoanthue.ai.vn

# AgentClan (backend-only — never expose to frontend)
AGENTCLAN_API_KEY=${AGENTCLAN_API_KEY}
AGENTCLAN_API_URL=http://web:8080

# Frontend public vars
NEXT_PUBLIC_API_URL=https://api.ketoanthue.ai.vn
NEXT_PUBLIC_APP_URL=https://ketoanthue.ai.vn
