# ===========================================
# Ketoanthue Environment Variables
# Copy this file to .env and fill in all values
# ===========================================

# ===========================================
# PostgreSQL Database
# ===========================================
POSTGRES_DB=ketoanthue
POSTGRES_USER=ketoanthue
POSTGRES_PASSWORD=ketoanthue
DATABASE_URL=postgresql://ketoanthue:ketoanthue@postgres:5432/ketoanthue

# ===========================================
# Redis (Queue/Cache)
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379

# ===========================================
# Backend API Server
# ===========================================
PORT=3001

# CORS allowed origins (comma-separated)
# Example: https://ketoanthue.ai.vn,https://app.ketoanthue.ai.vn
ALLOWED_ORIGINS=http://localhost:3000

# ===========================================
# AgentClan Integration (backend-only secret)
# NEVER expose AGENTCLAN_API_KEY to frontend / NEXT_PUBLIC_ vars
# ===========================================
AGENTCLAN_API_KEY=your-agentclan-api-key-here
AGENTCLAN_API_URL=http://web:8080

# ===========================================
# Frontend (Next.js — public vars prefixed with NEXT_PUBLIC_)
# ===========================================

# Backend API URL that the web app calls
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public app URL (for SEO, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
